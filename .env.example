# GATHR local development only.
# Copy this file to .env.local and replace placeholders locally.
# Never commit .env.local or real credentials.

# Neon PostgreSQL — use the development branch connection string.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Google OAuth — required only when testing Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL="GATHR <onboarding@resend.dev>"

# Development-only Resend sandbox recipient routing.
# Use the email address associated with your Resend account.
RESEND_TEST_MODE=true
RESEND_TEST_RECIPIENT=
