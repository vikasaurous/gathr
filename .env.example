# GATHR local development only.
# Copy this file to .env.local and replace placeholders locally.
# Never commit .env.local or real credentials.

# Neon PostgreSQL — use the development branch connection string.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# Production origin for CSRF trusted-origins list (e.g. https://app.gathr.example.com).
# Leave unset in development. Must match the public-facing URL of the deployed app.
PRODUCTION_ORIGIN=

# Google OAuth — required only when testing Google sign-in.
# GOOGLE_CLIENT_ID is used server-side by Better Auth (OAuth + One Tap credential verification).
# VITE_GOOGLE_CLIENT_ID must be the same value and is exposed to the browser only as a
# public client ID — never expose GOOGLE_CLIENT_SECRET through VITE_ variables.
# Authorized JavaScript Origins in Google Cloud Console: http://localhost:8080 (dev),
# plus your production domain (e.g. https://app.gathr.example.com).
# Existing OAuth redirect URI (https://your-domain.com/api/auth/callback/google) must remain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL="GATHR <onboarding@resend.dev>"

# Development-only Resend sandbox recipient routing.
# Use the email address associated with your Resend account.
RESEND_TEST_MODE=true
RESEND_TEST_RECIPIENT=

# Comma-separated emails allowed to open /admin (verified emails only).
# Leave empty to disable the admin area entirely.
ADMIN_EMAILS=

# Backblaze B2 S3-compatible private object storage (server-only).
# Endpoint must use HTTPS and match B2_S3_REGION (e.g. https://s3.us-west-004.backblazeb2.com).
B2_S3_ENDPOINT=
B2_S3_REGION=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=